---
interface Props { small?: boolean; href?: string }
const { small = false, href = '#inicio' } = Astro.props;
---
<a class:list={['brand', { 'brand--small': small }]} href={href} aria-label="miZesta, volver al inicio"><img src="/images/brand-logo.webp" width="44" height="44" alt="" /><span>miZesta<span class="brand-dot">.</span></span></a>
